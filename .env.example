# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (used only if a CODE_*_MODEL below is set to a non-Ollama name) ---
OPENAI_API_KEY=sk-...

# --- Model routing ---
# Each variable picks BOTH the provider and the model:
#   a name containing ":" (Ollama tag convention, e.g. "qwen2.5-coder:14b") -> OllamaClient
#   any other name (e.g. "gpt-5.6-luna")                                   -> OpenAIClient
# There is no automatic fallback between providers: if the configured model
# is not available (Ollama doesn't have the tag pulled, or the OpenAI key is
# missing), the agent fails fast with a clear error instead of switching silently.
#
# Both roles default to the same local model (qwen2.5-coder:14b), a
# code-specialized model reused for both writing and reviewing. This was
# chosen after testing showed alternating between two different multi-GB
# local models forced Ollama to reload weights on every call, causing
# repeated timeouts — see README.md "Tradeoffs" for the full story. Point
# them at different models (or an OpenAI id) freely; it's a config change.
# Allowed example values: qwen2.5-coder:14b | gemma4:12b | gpt-5.6-luna
CODE_GENERATOR_MODEL=qwen2.5-coder:14b
CODE_REVIEW_MODEL=qwen2.5-coder:14b
