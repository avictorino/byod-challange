# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI ---
# Used if a CODE_*_MODEL below is set to a non-Ollama name, AND/OR as the
# one-time last-resort escalation described below. Leave unset/blank to
# disable OpenAI entirely (agent runs 100% local, escalation is skipped).
OPENAI_API_KEY=sk-...

# --- Model routing ---
# Each CODE_*_MODEL variable picks BOTH the provider and the model:
#   a name containing ":" (Ollama tag convention, e.g. "qwen2.5-coder:14b") -> OllamaClient
#   any other name (e.g. "gpt-5.6-luna")                                   -> OpenAIClient
# There is no automatic fallback between providers for these two: if the
# configured model is not available (Ollama doesn't have the tag pulled, or
# the OpenAI key is missing), the agent fails fast with a clear error
# instead of switching silently.
#
# Both roles default to the same local model (qwen2.5-coder:14b), a
# code-specialized model reused for both writing and reviewing — chosen
# after testing showed alternating between two different multi-GB local
# models forced Ollama to reload weights on every call, causing repeated
# timeouts. Point them at different models (or an OpenAI id) freely; it's
# a config change, not a code change.
# Allowed example values: qwen2.5-coder:14b | gemma4:12b | gpt-5.6-luna
CODE_GENERATOR_MODEL=qwen2.5-coder:14b
CODE_REVIEW_MODEL=qwen2.5-coder:14b

# --- Escalation (opt-in, last resort only) ---
# If OPENAI_API_KEY is set above, the graph's Repair loop gets one extra
# attempt on OpenAI (the "Escalate" node) after every local retry
# (--max-retries) is exhausted and still fails — at most once per run, on
# only the files still broken at that point. Everything is attempted on
# the free local model first; this only spends real tokens/money as a
# last resort. If OPENAI_API_KEY is unset, this step is skipped entirely
# and the run finalizes with whatever the local retries produced.
OPENAI_MODEL=gpt-4o-mini

# --- Cost estimate ---
# $ per 1M tokens, used ONLY for the final cost estimate printed by
# Finalize — doesn't affect behavior. Ollama is never priced (always $0);
# these rates apply only to real OpenAI usage (Finalize uses the exact
# input/output token counts each API call returns, not an estimate).
# Defaults below are GPT-5.6 Luna's real published rates (matches
# OPENAI_MODEL's default above). Swap both if you point OPENAI_MODEL at
# a different GPT-5.6 tier:
#   Sol (flagship):   input 5.00  / output 30.00
#   Terra (balanced): input 2.00  / output 12.00
#   Luna (default):   input 0.20  / output  1.20
OPENAI_INPUT_PRICE_PER_1M=0.20
OPENAI_OUTPUT_PRICE_PER_1M=1.20
